{
  "name": "razorpay-js-monorepo",
  "private": true,
  "type": "module",
  "description": "Community-maintained, type-safe Razorpay Checkout SDKs for JavaScript frameworks.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "check:exports": "turbo run check:exports",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@razorpay-js/eslint-config": "workspace:*",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "size-limit": [
    {
      "name": "@razorpay-js/core",
      "path": "packages/core/dist/index.mjs",
      "limit": "2 kB"
    },
    {
      "name": "@razorpay-js/react",
      "path": "packages/react/dist/index.mjs",
      "import": "{ useRazorpay }",
      "ignore": [
        "react",
        "@razorpay-js/core"
      ],
      "limit": "1 kB"
    }
  ]
}
