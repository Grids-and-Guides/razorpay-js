{
  "name": "@razorpay-js/core",
  "version": "1.0.0-next.0",
  "description": "Framework-agnostic, type-safe loader and helpers for Razorpay Checkout. Community-maintained; not affiliated with Razorpay.",
  "keywords": [
    "razorpay",
    "checkout",
    "payment",
    "payment-gateway",
    "upi",
    "typescript"
  ],
  "license": "MIT",
  "author": "Grids and Guides",
  "homepage": "https://github.com/Grids-and-Guides/razorpay-js/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grids-and-Guides/razorpay-js.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/Grids-and-Guides/razorpay-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:exports": "publint --strict && attw --pack ."
  },
  "devDependencies": {
    "@razorpay-js/tsconfig": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
